+#[cfg(test)]
+mod tests {
+    use super::*;
+    use std::time::{SystemTime, UNIX_EPOCH};
+
+    struct Fixture(PathBuf);
+    impl Fixture {
+        fn new() -> Self {
+            let stamp = SystemTime::now()
+                .duration_since(UNIX_EPOCH)
+                .unwrap()
+                .as_nanos();
+            let path = std::env::temp_dir()
+                .join(format!("resources-platform-{}-{stamp}", std::process::id()));
+            fs::create_dir(&path).unwrap();
+            Self(path)
+        }
+        fn write(&self, path: &str, contents: impl AsRef<[u8]>) {
+            let path = self.0.join(path);
+            fs::create_dir_all(path.parent().unwrap()).unwrap();
+            fs::write(path, contents).unwrap();
+        }
+    }
+    impl Drop for Fixture {
+        fn drop(&mut self) {
+            fs::remove_dir_all(&self.0).unwrap();
+        }
+    }
+
+    #[test]
+    fn soc_name_requires_machine_and_preserves_family() {
+        let f = Fixture::new();
+        f.write("soc/soc0/machine", "SM8750\n");
+        f.write("soc/soc0/family", "Snapdragon\n");
+        assert_eq!(
+            soc_model_name(&f.0.join("soc")).as_deref(),
+            Some("Snapdragon SM8750")
+        );
+        assert_eq!(
+            cpu_model_name(Some("Qualcomm Oryon".into()), &f.0.join("soc")).as_deref(),
+            Some("Qualcomm Oryon")
+        );
+        f.write("soc/soc0/machine", "\n");
+        assert!(soc_model_name(&f.0.join("soc")).is_none());
+    }
+
+    #[test]
+    fn cpu_temperature_ignores_unrelated_and_invalid_sensors() {
+        let f = Fixture::new();
+        for (index, name, value) in [
+            (0, "cpu-0-0-0-thermal", "42000"),
+            (1, "cpu-1-0-0-thermal", "51000"),
+            (2, "gpuss0-thermal", "99000"),
+            (3, "cpu-0-1-0-thermal", "NaN"),
+        ] {
+            f.write(&format!("thermal/thermal_zone{index}/type"), name);
+            f.write(&format!("thermal/thermal_zone{index}/temp"), value);
+        }
+        assert_eq!(
+            highest_temperature(&cpu_thermal_paths(&f.0.join("thermal"))),
+            Some(51.0)
+        );
+    }
+
+    #[test]
+    fn gpu_temperature_requires_a_matching_cooling_phandle() {
+        let f = Fixture::new();
+        f.write("gpu/of_node/phandle", 0x123u32.to_be_bytes());
+        f.write("gpu/of_node/#cooling-cells", 2u32.to_be_bytes());
+        f.write(
+            "dt/thermal-zones/gpuss0-thermal/cooling-maps/map0/cooling-device",
+            [0x123u32, u32::MAX, u32::MAX]
+                .into_iter()
+                .flat_map(u32::to_be_bytes)
+                .collect::<Vec<_>>(),
+        );
+        f.write("thermal/thermal_zone0/type", "gpuss0-thermal\n");
+        f.write("thermal/thermal_zone0/temp", "48000\n");
+        f.write("thermal/thermal_zone1/type", "gpuss1-thermal\n");
+        f.write("thermal/thermal_zone1/temp", "99000\n");
+        let paths = device_thermal_paths(&f.0.join("gpu"), &f.0.join("dt"), &f.0.join("thermal"));
+        assert_eq!(highest_temperature(&paths), Some(48.0));
+        f.write("gpu/of_node/phandle", 0x456u32.to_be_bytes());
+        assert!(
+            device_thermal_paths(&f.0.join("gpu"), &f.0.join("dt"), &f.0.join("thermal"))
+                .is_empty()
+        );
+    }
+
+    #[test]
+    fn adreno_component_requires_an_exact_unambiguous_chip_id() {
+        let f = Fixture::new();
+        f.write(
+            "dt/soc/gpu/compatible",
+            b"qcom,adreno-44050001\0qcom,adreno\0",
+        );
+        assert_eq!(
+            adreno_node(&f.0.join("dt"), 0x44050001),
+            Some(f.0.join("dt/soc/gpu"))
+        );
+        assert!(adreno_node(&f.0.join("dt"), 0x44050002).is_none());
+        f.write("dt/soc/gpu2/compatible", b"qcom,adreno-44050001\0");
+        assert!(adreno_node(&f.0.join("dt"), 0x44050001).is_none());
+        f.write("dt/soc/gpu2/status", b"disabled\0");
+        assert!(adreno_node(&f.0.join("dt"), 0x44050001).is_some());
+    }
+}
