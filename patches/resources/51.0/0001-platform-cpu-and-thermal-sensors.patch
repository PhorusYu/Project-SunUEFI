+fn msm_chip_id(card: &Path) -> Option<u32> {
+    #[repr(C)]
+    struct MsmParam {
+        pipe: u32,
+        param: u32,
+        value: u64,
+        len: u32,
+        pad: u32,
+    }
+    // DRM_IOCTL_MSM_GET_PARAM: read-only msm_drm.h UAPI, not DRM master-only.
+    let request = ((3u32 << 30) | (24 << 16) | ((b'd' as u32) << 8) | 0x40) as libc::c_ulong;
+    let entries = std::fs::read_dir(card.join("device/drm")).ok()?;
+    for entry in entries.flatten() {
+        let name = entry.file_name();
+        if !name.to_string_lossy().starts_with("renderD") {
+            continue;
+        }
+        let Ok(file) = File::open(Path::new("/dev/dri").join(name)) else {
+            continue;
+        };
+        let mut param = MsmParam {
+            pipe: 0x10,
+            param: 0x03,
+            value: 0,
+            len: 0,
+            pad: 0,
+        };
+        // SAFETY: the descriptor is live and param has the exact kernel UAPI layout.
+        if unsafe { libc::ioctl(file.as_raw_fd(), request, &mut param) } == 0 {
+            return Some(param.value as u32);
+        }
+    }
+    None
 }
 
