+//! Platform information exposed by the Linux SoC and thermal subsystems.
+
+use std::{
+    fs,
+    path::{Path, PathBuf},
+};
+
+pub fn cpu_model_name(existing: Option<String>, soc_root: &Path) -> Option<String> {
+    existing
+        .filter(|name| !name.trim().is_empty())
+        .or_else(|| soc_model_name(soc_root))
+}
+
+pub fn soc_model_name(root: &Path) -> Option<String> {
+    let mut devices: Vec<_> = fs::read_dir(root)
+        .ok()?
+        .flatten()
+        .map(|entry| entry.path())
+        .collect();
+    devices.sort();
+    for device in devices {
+        let machine = fs::read_to_string(device.join("machine")).ok();
+        let Some(machine) = machine
+            .as_deref()
+            .map(str::trim)
+            .filter(|name| !name.is_empty())
+        else {
+            continue;
+        };
+        let family = fs::read_to_string(device.join("family")).unwrap_or_default();
+        let family = family.trim();
+        return Some(if family.is_empty() || machine.contains(family) {
+            machine.to_owned()
+        } else {
+            format!("{family} {machine}")
+        });
+    }
+    None
+}
+
+pub fn cpu_thermal_paths(root: &Path) -> Vec<PathBuf> {
+    let Ok(zones) = fs::read_dir(root) else {
+        return Vec::new();
+    };
+    zones
+        .flatten()
+        .filter_map(|zone| {
+            let path = zone.path();
+            let name = fs::read_to_string(path.join("type")).ok()?;
+            let name = name.trim();
+            (name.starts_with("cpu-") && name.ends_with("thermal")).then(|| path.join("temp"))
+        })
+        .collect()
+}
+
+pub fn highest_temperature(paths: &[PathBuf]) -> Option<f64> {
+    paths
+        .iter()
+        .filter_map(|path| {
+            let value = fs::read_to_string(path).ok()?.trim().parse::<f64>().ok()?;
+            value.is_finite().then_some(value / 1000.0)
+        })
+        .max_by(f64::total_cmp)
+}
+
+fn read_cells(path: &Path) -> Option<Vec<u32>> {
+    let bytes = fs::read(path).ok()?;
+    if bytes.len() % 4 != 0 {
+        return None;
+    }
+    Some(
+        bytes
+            .chunks_exact(4)
+            .map(|cell| u32::from_be_bytes(cell.try_into().unwrap()))
+            .collect(),
+    )
+}
+
+fn targets_device(map: &Path, phandle: u32) -> bool {
+    let Some(cells) = read_cells(&map.join("cooling-device")) else {
+        return false;
+    };
+    // The thermal binding specifies two cooling state arguments per provider.
+    cells.len() % 3 == 0 && cells.chunks_exact(3).any(|entry| entry[0] == phandle)
+}
+
+/// Match thermal zones through their cooling-device phandle, never through a GPU name.
+pub fn device_thermal_paths(device: &Path, device_tree: &Path, thermal: &Path) -> Vec<PathBuf> {
+    node_thermal_paths(&device.join("of_node"), device_tree, thermal)
+}
+
+/// An MSM DRM master may be the display controller, while its GPU is a component.
+/// Match the GPU's kernel-reported chip ID instead of assuming a global GPU sensor.
+pub fn adreno_node(root: &Path, chip_id: u32) -> Option<PathBuf> {
+    fn visit(root: &Path, compatible: &[u8], found: &mut Vec<PathBuf>) {
+        if fs::read(root.join("compatible")).is_ok_and(|bytes| {
+            bytes
+                .split(|byte| *byte == 0)
+                .any(|entry| entry == compatible)
+        }) {
+            let enabled = fs::read(root.join("status")).map_or(true, |value| {
+                value
+                    .split(|byte| *byte == 0)
+                    .next()
+                    .is_some_and(|status| status == b"okay" || status == b"ok")
+            });
+            if enabled {
+                found.push(root.to_owned());
+            }
+        }
+        if let Ok(entries) = fs::read_dir(root) {
+            for entry in entries.flatten() {
+                if entry.file_type().is_ok_and(|kind| kind.is_dir()) {
+                    visit(&entry.path(), compatible, found);
+                }
+            }
+        }
+    }
+    let compatible = format!("qcom,adreno-{chip_id:08x}");
+    let mut found = Vec::new();
+    visit(root, compatible.as_bytes(), &mut found);
+    (found.len() == 1).then(|| found.remove(0))
+}
+
+pub fn node_thermal_paths(node: &Path, device_tree: &Path, thermal: &Path) -> Vec<PathBuf> {
+    if read_cells(&node.join("#cooling-cells")).as_deref() != Some(&[2]) {
+        return Vec::new();
+    }
+    let Some(phandle) = read_cells(&node.join("phandle"))
+        .or_else(|| read_cells(&node.join("linux,phandle")))
+        .and_then(|cells| (cells.len() == 1).then(|| cells[0]))
+    else {
+        return Vec::new();
+    };
+    let Ok(zones) = fs::read_dir(device_tree.join("thermal-zones")) else {
+        return Vec::new();
+    };
+    let mut names = Vec::new();
+    for zone in zones.flatten() {
+        let Ok(maps) = fs::read_dir(zone.path().join("cooling-maps")) else {
+            continue;
+        };
+        if maps
+            .flatten()
+            .any(|map| targets_device(&map.path(), phandle))
+        {
+            names.push(zone.file_name());
+        }
+    }
+    let Ok(zones) = fs::read_dir(thermal) else {
+        return Vec::new();
+    };
+    zones
+        .flatten()
+        .filter_map(|zone| {
+            let path = zone.path();
+            let name = fs::read_to_string(path.join("type")).ok()?;
+            names
+                .iter()
+                .any(|candidate| candidate == name.trim())
+                .then(|| path.join("temp"))
+        })
+        .collect()
+}
