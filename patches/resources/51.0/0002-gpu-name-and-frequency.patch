+
+/// Platform GPUs expose their clock through devfreq. Identify the GPU device by
+/// its device-tree compatible instead of any invented name.
+fn devfreq_core_frequency() -> Result<f64> {
+    for entry in std::fs::read_dir("/sys/class/devfreq")? {
+        let path = entry?.path();
+        let Ok(uevent) = std::fs::read_to_string(path.join("device/uevent")) else {
+            continue;
+        };
+        let is_gpu = uevent.lines().any(|line| {
+            line.strip_prefix("OF_COMPATIBLE_")
+                .and_then(|rest| rest.split_once('='))
+                .is_some_and(|(_index, value)| value.starts_with("qcom,adreno"))
+        });
+        if !is_gpu {
+            continue;
+        }
+        let hertz = std::fs::read_to_string(path.join("cur_freq"))?;
+        return Ok(hertz.trim().parse::<f64>()?);
+    }
+    bail!("no adreno devfreq device")
+}
