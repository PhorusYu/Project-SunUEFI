+
+/// Renderer string reported by the standard GTK helper.
+///
+/// Querying GL from inside the app is not safe on this stack: a shared, surfaceless
+/// context realizes fine but `glGetString` segfaults. The helper uses a pbuffer
+/// surface and prints the same string the desktop tools show, so reuse it instead
+/// of inventing a GPU name.
+static GPU_RENDERER: std::sync::OnceLock<Option<String>> = std::sync::OnceLock::new();
+
+const RENDERER_HELPERS: &[&str] = &["/usr/libexec/gnome-control-center-print-renderer"];
+
+pub fn gpu_renderer_name() -> Option<String> {
+    GPU_RENDERER
+        .get_or_init(|| {
+            RENDERER_HELPERS.iter().find_map(|helper| {
+                let output = std::process::Command::new(helper).output().ok()?;
+                if !output.status.success() {
+                    return None;
+                }
+                let name = String::from_utf8(output.stdout).ok()?;
+                let name = name.trim();
+                (!name.is_empty()).then(|| name.to_owned())
+            })
+        })
+        .clone()
+}
