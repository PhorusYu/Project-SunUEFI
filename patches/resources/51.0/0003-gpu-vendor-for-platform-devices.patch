+/// SoC vendor from the device-tree root compatible string.
+///
+/// Only the vendor prefix is consulted; nothing about a model or a marketing
+/// name is guessed here.
+pub fn soc_vendor_name(root: &Path) -> Option<String> {
+    let raw = fs::read(root.join("compatible")).ok()?;
+    for entry in raw.split(|byte| *byte == 0).filter(|entry| !entry.is_empty()) {
+        let entry = std::str::from_utf8(entry).ok()?;
+        let (vendor, _model) = entry.split_once(',')?;
+        let name = match vendor {
+            "qcom" => "Qualcomm",
+            "mediatek" => "MediaTek",
+            "rockchip" => "Rockchip",
+            "nvidia" => "NVIDIA",
+            "apple" => "Apple",
+            _ => continue,
+        };
+        return Some(name.to_owned());
+    }
+    None
+}
