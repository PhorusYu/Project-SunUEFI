static int novatek_nt37801_off(struct novatek_nt37801 *ctx)
{
	struct mipi_dsi_device *dsi = ctx->dsi;
	struct mipi_dsi_multi_context dsi_ctx = { .dsi = dsi };

	dsi->mode_flags &= ~MIPI_DSI_MODE_LPM;

	mipi_dsi_dcs_set_display_off_multi(&dsi_ctx);
	mipi_dsi_msleep(&dsi_ctx, 20);

	mipi_dsi_dcs_enter_sleep_mode_multi(&dsi_ctx);
	mipi_dsi_msleep(&dsi_ctx, 120);

	return dsi_ctx.accum_err;
}

/* OEM o11u rails: vddio, GPIO-controlled vddd ("vdd"), then vci. */
static const unsigned int o11u_supply_order[] = { 0, 2, 1 };

static int novatek_nt37801_disable_supplies(struct novatek_nt37801 *ctx,
					  int enabled)
{
	int i, ret, first_error = 0;

	if (!ctx->is_o11u)
		return regulator_bulk_disable(ARRAY_SIZE(novatek_nt37801_supplies),
					      ctx->supplies);

	for (i = enabled - 1; i >= 0; i--) {
		unsigned int supply = o11u_supply_order[i];

		ret = regulator_disable(ctx->supplies[supply].consumer);
		if (ret) {
			dev_err(&ctx->dsi->dev, "Failed to disable %s: %d\n",
				ctx->supplies[supply].supply, ret);
			if (!first_error)
				first_error = ret;
		}
		if (supply != 0)
			msleep(3);
	}

	return first_error;
}

static int novatek_nt37801_enable_supplies(struct novatek_nt37801 *ctx)
{
	unsigned int i;
	int ret;

	if (!ctx->is_o11u)
		return regulator_bulk_enable(ARRAY_SIZE(novatek_nt37801_supplies),
					     ctx->supplies);

	for (i = 0; i < ARRAY_SIZE(o11u_supply_order); i++) {
		unsigned int supply = o11u_supply_order[i];

		ret = regulator_enable(ctx->supplies[supply].consumer);
		if (ret) {
			novatek_nt37801_disable_supplies(ctx, i);
			return ret;
		}
		msleep(10);
	}

	return 0;
}

static int novatek_nt37801_write_dbv(struct mipi_dsi_device *dsi,
				     u16 brightness)
{
	int ret;

	dsi->mode_flags &= ~MIPI_DSI_MODE_LPM;

	ret = mipi_dsi_dcs_set_display_brightness_large(dsi, brightness);

	dsi->mode_flags |= MIPI_DSI_MODE_LPM;

	return ret;
}

static int novatek_nt37801_prepare(struct drm_panel *panel)
{
	struct novatek_nt37801 *ctx = to_novatek_nt37801(panel);
	struct mipi_dsi_device *dsi = ctx->dsi;
	struct mipi_dsi_multi_context dsi_ctx = { .dsi = dsi };
	struct drm_dsc_picture_parameter_set pps;
	int ret;

	if (ctx->blanked) {
		/* The panel kept power and memory: just turn the display back on. */
		mipi_dsi_dcs_set_display_on(dsi);
		msleep(20);
		ctx->blanked = false;
		ctx->prepared = true;
		return 0;
	}

	ret = novatek_nt37801_enable_supplies(ctx);
	if (ret < 0)
		return ret;

	novatek_nt37801_reset(ctx);
	if (ctx->is_o11u)
		xiaomi_o11u_on(&dsi_ctx);
	else
		novatek_nt37801_on(&dsi_ctx);
	drm_dsc_pps_payload_pack(&pps, &ctx->dsc);
	mipi_dsi_picture_parameter_set_multi(&dsi_ctx, &pps);
	mipi_dsi_compression_mode_multi(&dsi_ctx, true);
	if (dsi_ctx.accum_err) {
		ret = dsi_ctx.accum_err;
		goto err;
	}

	msleep(28);
	ctx->prepared = true;

	return 0;

err:
	gpiod_set_value_cansleep(ctx->reset_gpio, 1);
	novatek_nt37801_disable_supplies(ctx, ARRAY_SIZE(o11u_supply_order));

	return ret;
}

static int novatek_nt37801_unprepare(struct drm_panel *panel)
{
	struct novatek_nt37801 *ctx = to_novatek_nt37801(panel);
	struct device *dev = &ctx->dsi->dev;
	int ret;

	ctx->prepared = false;
	cancel_delayed_work_sync(&ctx->dbv_work);

	/*
	 * Blank without resetting the panel. A reset discards the panel's frame
	 * memory, and the garbage it then shows lasts until every region has
	 * been redrawn by the compositor.
	 */
	ret = novatek_nt37801_write_dbv(ctx->dsi, 0);
	if (ret < 0)
		dev_err(dev, "Failed to blank brightness: %d\n", ret);

	mipi_dsi_dcs_set_display_off(ctx->dsi);
	msleep(20);
	ctx->blanked = true;

	return 0;
}

static const struct drm_display_mode novatek_nt37801_mode = {
	.clock = (1440 + 20 + 4 + 20) * (3200 + 20 + 2 + 18) * 120 / 1000,
	.hdisplay = 1440,
	.hsync_start = 1440 + 20,
	.hsync_end = 1440 + 20 + 4,
	.htotal = 1440 + 20 + 4 + 20,
	.vdisplay = 3200,
	.vsync_start = 3200 + 20,
	.vsync_end = 3200 + 20 + 2,
	.vtotal = 3200 + 20 + 2 + 18,
	.type = DRM_MODE_TYPE_DRIVER,
};

static const struct drm_display_mode xiaomi_o11u_mode = {
	.clock = (1440 + 64 + 12 + 64) * (3200 + 16 + 14 + 6) * 120 / 1000,
	.hdisplay = 1440,
	.hsync_start = 1440 + 64,
	.hsync_end = 1440 + 64 + 12,
	.htotal = 1440 + 64 + 12 + 64,
	.vdisplay = 3200,
	.vsync_start = 3200 + 16,
	.vsync_end = 3200 + 16 + 14,
	.vtotal = 3200 + 16 + 14 + 6,
	.type = DRM_MODE_TYPE_DRIVER,
};

static int novatek_nt37801_get_modes(struct drm_panel *panel,
				     struct drm_connector *connector)
{
	struct novatek_nt37801 *ctx = to_novatek_nt37801(panel);
	return drm_connector_helper_get_modes_fixed(connector,
						    ctx->is_o11u ? &xiaomi_o11u_mode : &novatek_nt37801_mode);
}

/*
 * The NT37801 drops DBV writes that race the end of its own power-up sequence.
 * After a DPMS off/on cycle the DCS init, every DPU commit and all TE events
 * complete, yet the panel stays dark until userspace writes the brightness
 * again. Re-apply the requested brightness once the panel has settled, before
 * the backlight core enables it.
 */
/* Delays after display-on for the brightness re-apply attempts. */
static const unsigned int novatek_nt37801_dbv_delay_ms[] = { 120, 400, 1200, 3000 };

static void novatek_nt37801_dbv_work(struct work_struct *work)
{
	struct novatek_nt37801 *ctx =
		container_of(to_delayed_work(work), struct novatek_nt37801,
			     dbv_work);
	struct backlight_device *bl = ctx->panel.backlight;
	unsigned int idx = ctx->dbv_retry;
	int ret;

	if (!bl || !ctx->prepared)
		return;

	ret = novatek_nt37801_write_dbv(ctx->dsi, bl->props.brightness);
	dev_info(&ctx->dsi->dev, "brightness re-apply #%u (%u): %d\n",
		 idx, bl->props.brightness, ret);

	if (++ctx->dbv_retry < ARRAY_SIZE(novatek_nt37801_dbv_delay_ms))
		schedule_delayed_work(&ctx->dbv_work,
			msecs_to_jiffies(novatek_nt37801_dbv_delay_ms[ctx->dbv_retry]));
}

static int novatek_nt37801_enable(struct drm_panel *panel)
{
	struct novatek_nt37801 *ctx = to_novatek_nt37801(panel);

	if (!panel->backlight)
		return 0;

	/* The panel drops DBV writes issued during its power-up window: retry
	 * over the next few seconds instead of trusting a single early write.
	 */
	ctx->dbv_retry = 0;
	schedule_delayed_work(&ctx->dbv_work,
			      msecs_to_jiffies(novatek_nt37801_dbv_delay_ms[0]));

	return 0;
}

static const struct drm_panel_funcs novatek_nt37801_panel_funcs = {
	.prepare = novatek_nt37801_prepare,
	.enable = novatek_nt37801_enable,
	.unprepare = novatek_nt37801_unprepare,
	.get_modes = novatek_nt37801_get_modes,
};

static int novatek_nt37801_bl_update_status(struct backlight_device *bl)
{
	return novatek_nt37801_write_dbv(bl_get_data(bl),
					 backlight_get_brightness(bl));
}

static const struct backlight_ops novatek_nt37801_bl_ops = {
	.update_status = novatek_nt37801_bl_update_status,
};

static struct backlight_device *
novatek_nt37801_create_backlight(struct mipi_dsi_device *dsi)
{
	struct device *dev = &dsi->dev;
	const struct backlight_properties props = {
		.type = BACKLIGHT_RAW,
		.brightness = 4095,
		.max_brightness = 4095,
	};

	return devm_backlight_device_register(dev, dev_name(dev), dev, dsi,
					      &novatek_nt37801_bl_ops, &props);
}

static int novatek_nt37801_probe(struct mipi_dsi_device *dsi)
{
	struct device *dev = &dsi->dev;
	struct novatek_nt37801 *ctx;
	int ret;

	ctx = devm_drm_panel_alloc(dev, struct novatek_nt37801, panel,
				   &novatek_nt37801_panel_funcs,
				   DRM_MODE_CONNECTOR_DSI);
	if (IS_ERR(ctx))
		return PTR_ERR(ctx);

	ret = devm_regulator_bulk_get_const(dev,
					    ARRAY_SIZE(novatek_nt37801_supplies),
					    novatek_nt37801_supplies,
					    &ctx->supplies);
	if (ret < 0)
		return ret;

	ctx->reset_gpio = devm_gpiod_get(dev, "reset", GPIOD_OUT_LOW);
	if (IS_ERR(ctx->reset_gpio))
		return dev_err_probe(dev, PTR_ERR(ctx->reset_gpio),
				     "Failed to get reset-gpios\n");

	ctx->is_o11u = of_device_is_compatible(dev->of_node, "xiaomi,miro-o11u");
	INIT_DELAYED_WORK(&ctx->dbv_work, novatek_nt37801_dbv_work);
	ctx->dsi = dsi;
	mipi_dsi_set_drvdata(dsi, ctx);

	dsi->lanes = 4;
	dsi->format = MIPI_DSI_FMT_RGB888;
	dsi->mode_flags = ctx->is_o11u ? 0 : (MIPI_DSI_MODE_NO_EOT_PACKET | MIPI_DSI_CLOCK_NON_CONTINUOUS);

	ctx->panel.prepare_prev_first = true;
	ctx->panel.backlight = novatek_nt37801_create_backlight(dsi);
	if (IS_ERR(ctx->panel.backlight))
		return dev_err_probe(dev, PTR_ERR(ctx->panel.backlight),
				     "Failed to create backlight\n");

	drm_panel_add(&ctx->panel);

	/* This panel only supports DSC; unconditionally enable it */
	dsi->dsc = &ctx->dsc;
	ctx->dsc.dsc_version_major = 1;
	if (ctx->is_o11u) {
		ctx->dsc.dsc_version_minor = 2;
		ctx->dsc.slice_height = 20;
		ctx->dsc.slice_width = 720;
		ctx->dsc.slice_count = 1440 / ctx->dsc.slice_width;
		ctx->dsc.bits_per_component = 10;
	} else {
		ctx->dsc.dsc_version_minor = 1;
		ctx->dsc.slice_height = 40;
		ctx->dsc.slice_width = 720;
		ctx->dsc.slice_count = 1440 / ctx->dsc.slice_width;
		ctx->dsc.bits_per_component = 8;
	}
	ctx->dsc.bits_per_pixel = 8 << 4; /* 4 fractional bits */
	ctx->dsc.block_pred_enable = true;

	ret = mipi_dsi_attach(dsi);
	if (ret < 0) {
		drm_panel_remove(&ctx->panel);
		return dev_err_probe(dev, ret, "Failed to attach to DSI host\n");
	}

	return 0;
}

static void novatek_nt37801_remove(struct mipi_dsi_device *dsi)
{
	struct novatek_nt37801 *ctx = mipi_dsi_get_drvdata(dsi);
	int ret;

	ret = mipi_dsi_detach(dsi);
	if (ret < 0)
		dev_err(&dsi->dev, "Failed to detach from DSI host: %d\n", ret);

	drm_panel_remove(&ctx->panel);
}

static const struct of_device_id novatek_nt37801_of_match[] = {
	{ .compatible = "novatek,nt37801" },
	{ .compatible = "xiaomi,miro-o11u" },
	{}
};
MODULE_DEVICE_TABLE(of, novatek_nt37801_of_match);

static struct mipi_dsi_driver novatek_nt37801_driver = {
	.probe = novatek_nt37801_probe,
	.remove = novatek_nt37801_remove,
	.driver = {
		.name = "panel-novatek-nt37801",
		.of_match_table = novatek_nt37801_of_match,
	},
};
module_mipi_dsi_driver(novatek_nt37801_driver);

MODULE_AUTHOR("Krzysztof Kozlowski <krzysztof.kozlowski@linaro.org>");
MODULE_DESCRIPTION("Panel driver for the Novatek NT37801/NT37810 AMOLED DSI panel");
MODULE_LICENSE("GPL");
