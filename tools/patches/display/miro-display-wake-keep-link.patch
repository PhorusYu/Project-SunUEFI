# miro display wake fix (verified on device, kernel #98)

State: Redmi K80 Pro (miro / SM8750), Linux 7.3.3-miro-sunuefi+ #98,
Debian sid, GNOME Wayland, NT37801 AMOLED, DPU command mode + DSC.

## Symptom that was fixed
Pressing the power button (blank) and waking again left the internal panel
black until a full power cycle.

## What the measurements showed
1. After a wake where the DSI host had been runtime-suspended
   (`DSI power-on runtime PM ret=0`), the first DCS command's DMA never
   completed (`STATUS0=0x3`, no `DMA_DONE`, DSI IRQ count frozen), the panel
   init aborted and the whole commit failed (also REGDMA/frame-done/kickoff
   timeouts). With the DSI/PHY kept runtime-active (`ret=1`) the same cycle was
   clean, so the link power cycle is what broke it.
2. Reset+full re-init of the panel on every unprepare cleared the panel's frame
   memory; the following seconds showed full-screen garbage until the
   compositor had redrawn every region.
3. Backlight/DBV itself was healthy and linear (15 faint, 1149 clearly visible,
   4095 bright); the DCS 0x51 path never needed changing.

## Changes
* dsi_host.c / dsi_phy.c: hold a runtime-PM reference so the DSI controller and
  PHY are not power-cycled while the panel is merely blanked.
* panel-novatek-nt37801.c: blank in place (DCS 0x28 + DBV 0) instead of
  reset + sleep-in + rail cycling, and turn the display back on with 0x29 on
  the next prepare; re-apply DBV a few times after enable
  (120/400/1200/3000 ms) for the panel's power-up window.

## Verified on device
Power button blank -> 3 s -> power button: desktop returns immediately, no
garbage, no kernel display errors (`DMA timeout`, `frame done timeout`,
`REGDMA`, `Skipping` all zero).

## Open items for the next AI
* The runtime-PM hold raises blanked-state power draw: the link and panel rails
  now stay powered while the screen is off. Worth measuring and, if needed,
  narrowing to "hold only between unprepare and the next prepare".
* The panel is no longer put into sleep-in (0x10) on blank; confirm this is
  acceptable for standby power before shipping.
* Upstream-quality direction: keep the same policy but express it as an
  explicit "blank, do not tear down" state in the panel + DSI bridge, and
  re-check the DSI resume path so the hold can eventually be dropped.

## Kernel-side diffs
```diff
--- a/drivers/gpu/drm/msm/dsi/dsi_host.c	2026-11-28 13:57:58.459903767 +0800
+++ b/drivers/gpu/drm/msm/dsi/dsi_host.c	2026-11-28 13:50:07.679763092 +0800
@@ -2672,6 +2672,11 @@
 	dsi_ctrl_enable(msm_host, phy_shared_timings, phy);
 
 	msm_host->power_on = true;
+	/*
+	 * Keep the controller runtime-active even while the panel is blanked:
+	 * resuming it produces DSI command DMA hangs on this SoC.
+	 */
+	pm_runtime_get_noresume(&msm_host->pdev->dev);
 	mutex_unlock(&msm_host->dev_mutex);
 
 	return 0;
```

```diff
--- a/drivers/gpu/drm/msm/dsi/phy/dsi_phy.c	2026-11-28 13:57:58.462318615 +0800
+++ b/drivers/gpu/drm/msm/dsi/phy/dsi_phy.c	2026-11-28 13:50:23.417626554 +0800
@@ -704,6 +704,12 @@
 		return dev_err_probe(dev, ret,
 				     "Failed to register clk provider\n");
 
+	/*
+	 * Keep the PHY runtime-active: a suspend/resume cycle of the PHY behind
+	 * a blanked panel leaves the DSI command DMA unable to complete.
+	 */
+	pm_runtime_get_noresume(dev);
+
 	return 0;
 }
 
```

## Panel driver functions (full current file: panel-novatek-nt37801.c.current)

```c
static int novatek_nt37801_prepare(struct drm_panel *panel)
{
	struct novatek_nt37801 *ctx = to_novatek_nt37801(panel);
	struct mipi_dsi_device *dsi = ctx->dsi;
	struct mipi_dsi_multi_context dsi_ctx = { .dsi = dsi };
	struct drm_dsc_picture_parameter_set pps;
	int ret;

	if (ctx->blanked) {
		/* The panel kept power and memory: just turn the display back on. */
		mipi_dsi_dcs_set_display_on(dsi);
		msleep(20);
		ctx->blanked = false;
		ctx->prepared = true;
		return 0;
	}

	ret = novatek_nt37801_enable_supplies(ctx);
	if (ret < 0)
		return ret;

	novatek_nt37801_reset(ctx);
	if (ctx->is_o11u)
		xiaomi_o11u_on(&dsi_ctx);
	else
		novatek_nt37801_on(&dsi_ctx);
	drm_dsc_pps_payload_pack(&pps, &ctx->dsc);
	mipi_dsi_picture_parameter_set_multi(&dsi_ctx, &pps);
	mipi_dsi_compression_mode_multi(&dsi_ctx, true);
	if (dsi_ctx.accum_err) {
		ret = dsi_ctx.accum_err;
		goto err;
	}

	msleep(28);
	ctx->prepared = true;

	return 0;

err:
	gpiod_set_value_cansleep(ctx->reset_gpio, 1);
	novatek_nt37801_disable_supplies(ctx, ARRAY_SIZE(o11u_supply_order));

	return ret;
}

```

```c
static int novatek_nt37801_unprepare(struct drm_panel *panel)
{
	struct novatek_nt37801 *ctx = to_novatek_nt37801(panel);
	struct device *dev = &ctx->dsi->dev;
	int ret;

	ctx->prepared = false;
	cancel_delayed_work_sync(&ctx->dbv_work);

	/*
	 * Blank without resetting the panel. A reset discards the panel's frame
	 * memory, and the garbage it then shows lasts until every region has
	 * been redrawn by the compositor.
	 */
	ret = novatek_nt37801_write_dbv(ctx->dsi, 0);
	if (ret < 0)
		dev_err(dev, "Failed to blank brightness: %d\n", ret);

	mipi_dsi_dcs_set_display_off(ctx->dsi);
	msleep(20);
	ctx->blanked = true;

	return 0;
}

```

```c
/* Delays after display-on for the brightness re-apply attempts. */
static const unsigned int novatek_nt37801_dbv_delay_ms[] = { 120, 400, 1200, 3000 };

static void novatek_nt37801_dbv_work(struct work_struct *work)
{
	struct novatek_nt37801 *ctx =
		container_of(to_delayed_work(work), struct novatek_nt37801,
			     dbv_work);
	struct backlight_device *bl = ctx->panel.backlight;
	unsigned int idx = ctx->dbv_retry;
	int ret;

	if (!bl || !ctx->prepared)
		return;

	ret = novatek_nt37801_write_dbv(ctx->dsi, bl->props.brightness);
	dev_info(&ctx->dsi->dev, "brightness re-apply #%u (%u): %d\n",
		 idx, bl->props.brightness, ret);

	if (++ctx->dbv_retry < ARRAY_SIZE(novatek_nt37801_dbv_delay_ms))
		schedule_delayed_work(&ctx->dbv_work,
			msecs_to_jiffies(novatek_nt37801_dbv_delay_ms[ctx->dbv_retry]));
}

static int novatek_nt37801_enable(struct drm_panel *panel)
{
	struct novatek_nt37801 *ctx = to_novatek_nt37801(panel);

	if (!panel->backlight)
		return 0;

	/* The panel drops DBV writes issued during its power-up window: retry
	 * over the next few seconds instead of trusting a single early write.
	 */
	ctx->dbv_retry = 0;
	schedule_delayed_work(&ctx->dbv_work,
			      msecs_to_jiffies(novatek_nt37801_dbv_delay_ms[0]));

	return 0;
}

```
